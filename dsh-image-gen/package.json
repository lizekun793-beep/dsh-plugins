{
  "name": "@local/image-gen",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Generate images through any OpenAI-compatible images endpoint, configured from the DSH Plugins page.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "image-generation",
    "text-to-image",
    "openai-compatible",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "author": "lizekun793-beep",
  "repository": {
    "type": "git",
    "url": "https://github.com/lizekun793-beep/dsh-plugins.git",
    "directory": "dsh-image-gen"
  }
}
